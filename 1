<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>幸運隨機抽號工具</title>
  <!-- Google Fonts 與 Bootstrap Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <style>
    :root {
      --primary: #f59e0b;
      --primary-hover: #d97706;
      --danger: #ef4444;
      --danger-hover: #dc2626;
      --bg: #0f172a;
      --card-bg: rgba(30, 41, 59, 0.85);
      --text: #f8fafc;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Noto Sans TC', sans-serif;
      background: radial-gradient(circle at top, #1e293b, #0f172a);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 600px;
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    h1 {
      text-align: center;
      font-size: 26px;
      margin-bottom: 24px;
      letter-spacing: 1px;
      background: linear-gradient(135deg, #fcd34d, #f59e0b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .screen {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .screen.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* 設定畫面 */
    .input-group {
      margin-bottom: 20px;
    }

    .input-group label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      color: #94a3b8;
    }

    .input-group input {
      width: 100%;
      padding: 12px 16px;
      border-radius: 10px;
      border: 1px solid #334155;
      background: #1e293b;
      color: #fff;
      font-size: 18px;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s;
    }

    .input-group input:focus {
      border-color: var(--primary);
    }

    /* 按鈕通用樣式 */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 14px;
      font-size: 18px;
      font-weight: 700;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-transform: uppercase;
    }

    .btn-primary {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
    }

    .btn-primary:hover:not(:disabled) {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      transform: translateY(-1px);
    }

    .btn-danger {
      background: #334155;
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-danger:hover:not(:disabled) {
      background: rgba(239, 68, 68, 0.15);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      box-shadow: none;
    }

    /* 抽獎區 */
    .info-bar {
      display: flex;
      justify-content: space-between;
      color: #94a3b8;
      font-size: 14px;
      margin-bottom: 20px;
      padding: 10px 14px;
      background: rgba(15, 23, 42, 0.6);
      border-radius: 8px;
    }

    /* 老虎機位數顯示區 */
    .digits-container {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin: 30px 0;
    }

    .digit-box {
      width: 70px;
      height: 90px;
      background: #020617;
      border-radius: 12px;
      border: 2px solid #334155;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Chakra Petch', sans-serif;
      font-size: 56px;
      font-weight: 700;
      color: #38bdf8;
      box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.8), 0 4px 8px rgba(0,0,0,0.3);
      position: relative;
      overflow: hidden;
    }

    .digit-box.rolling {
      border-color: #f59e0b;
      color: #fbbf24;
      animation: pulse 0.8s infinite alternate;
    }

    .digit-box.settled {
      border-color: #10b981;
      color: #34d399;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 5px rgba(245, 158, 11, 0.3); }
      100% { box-shadow: 0 0 16px rgba(245, 158, 11, 0.8); }
    }

    .controls-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }

    /* 抽中歷史清單 */
    .history-card {
      background: rgba(15, 23, 42, 0.7);
      border-radius: 12px;
      padding: 16px;
      border: 1px solid #1e293b;
    }

    .history-title {
      font-size: 14px;
      color: #94a3b8;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
    }

    .history-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      max-height: 140px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .history-badge {
      font-family: 'Chakra Petch', sans-serif;
      font-size: 16px;
      font-weight: 700;
      background: #1e293b;
      color: #38bdf8;
      padding: 6px 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      animation: scaleIn 0.3s ease;
    }

    .history-badge.latest {
      background: rgba(16, 185, 129, 0.2);
      border-color: #10b981;
      color: #34d399;
    }

    @keyframes scaleIn {
      from { transform: scale(0.6); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .empty-history {
      color: #64748b;
      font-size: 14px;
      text-align: center;
      width: 100%;
      padding: 10px;
    }

    /* 錯誤訊息 */
    .error-msg {
      color: var(--danger);
      font-size: 14px;
      margin-top: -12px;
      margin-bottom: 16px;
      display: none;
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- 畫面 1: 參數設定頁面 -->
    <div id="setup-screen" class="screen active">
      <h1><i class="bi bi-dice-5-fill"></i> 幸運號碼抽選機</h1>
      
      <div class="input-group">
        <label for="start-val"><i class="bi bi-arrow-bar-right"></i> 起始值 (包含)</label>
        <input type="number" id="start-val" value="1" placeholder="例如：1">
      </div>

      <div class="input-group">
        <label for="end-val"><i class="bi bi-arrow-bar-left"></i> 終點值 (包含)</label>
        <input type="number" id="end-val" value="100" placeholder="例如：100">
      </div>

      <div id="setup-error" class="error-msg">請填寫正確數值，且終點值須大於或等於起始值！</div>

      <button class="btn btn-primary" id="btn-enter-lottery">
        <i class="bi bi-play-circle-fill"></i> 前往抽獎
      </button>
    </div>

    <!-- 畫面 2: 抽獎進行頁面 -->
    <div id="lottery-screen" class="screen">
      <h1><i class="bi bi-trophy-fill"></i> 號碼抽選中</h1>
      
      <div class="info-bar">
        <span>範圍：<strong id="display-range" style="color: #fff;"></strong></span>
        <span>剩餘可抽：<strong id="display-remaining" style="color: #38bdf8;"></strong> 個</span>
      </div>

      <!-- 滾動數字卡 -->
      <div class="digits-container" id="digits-container">
        <!-- JS 會根據最大位數動態生成位數卡片 -->
      </div>

      <div class="controls-grid">
        <button class="btn btn-primary" id="btn-start">
          <i class="bi bi-play-fill" style="font-size: 24px;"></i> START
        </button>
        <button class="btn btn-danger" id="btn-exit">
          <i class="bi bi-power"></i> 結束
        </button>
      </div>

      <!-- 抽中清單 -->
      <div class="history-card">
        <div class="history-title">
          <span><i class="bi bi-clock-history"></i> 已開出號碼</span>
          <span id="history-count">0 個</span>
        </div>
        <div class="history-list" id="history-list">
          <div class="empty-history">尚未抽出任何號碼</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 狀態變數
    let minVal = 1;
    let maxVal = 100;
    let pool = [];
    let historyList = [];
    let maxDigits = 3;
    let isDrawing = false;
    let intervals = [];

    // DOM 元素
    const setupScreen = document.getElementById('setup-screen');
    const lotteryScreen = document.getElementById('lottery-screen');
    const startInput = document.getElementById('start-val');
    const endInput = document.getElementById('end-val');
    const setupError = document.getElementById('setup-error');
    const btnEnter = document.getElementById('btn-enter-lottery');
    const btnStart = document.getElementById('btn-start');
    const btnExit = document.getElementById('btn-exit');
    const digitsContainer = document.getElementById('digits-container');
    const displayRange = document.getElementById('display-range');
    const displayRemaining = document.getElementById('display-remaining');
    const historyListContainer = document.getElementById('history-list');
    const historyCount = document.getElementById('history-count');

    // 切換至抽獎畫面
    btnEnter.addEventListener('click', () => {
      const s = parseInt(startInput.value, 10);
      const e = parseInt(endInput.value, 10);

      if (isNaN(s) || isNaN(e) || s > e) {
        setupError.style.display = 'block';
        return;
      }
      setupError.style.display = 'none';

      minVal = s;
      maxVal = e;

      // 計算位數 (以端點數值較大者之位數為準，終點值 3 位數時即固定開出 3 格)
      maxDigits = Math.max(minVal.toString().length, maxVal.toString().length);

      // 初始化彩球池 (包含起始值與終點值)
      pool = [];
      for (let i = minVal; i <= maxVal; i++) {
        pool.push(i);
      }
      historyList = [];

      // 更新畫面
      displayRange.textContent = `${minVal} ~ ${maxVal}`;
      updateRemaining();
      renderDigits(new Array(maxDigits).fill('-'));
      renderHistory();

      // 切換頁面
      setupScreen.classList.remove('active');
      lotteryScreen.classList.add('active');
      btnStart.disabled = false;
    });

    // 建立指定數量的位數方格
    function renderDigits(chars) {
      digitsContainer.innerHTML = '';
      chars.forEach((char) => {
        const box = document.createElement('div');
        box.className = 'digit-box';
        box.textContent = char;
        digitsContainer.appendChild(box);
      });
    }

    // 更新剩餘號碼資訊
    function updateRemaining() {
      displayRemaining.textContent = pool.length;
    }

    // 按下 START 開始抽號
    btnStart.addEventListener('click', () => {
      if (isDrawing) return;

      if (pool.length === 0) {
        alert('設定範圍內的所有號碼都已經全數抽出囉！');
        return;
      }

      isDrawing = true;
      btnStart.disabled = true;
      btnExit.disabled = true;

      // 隨機選出一個得獎號碼並從球池移除
      const randomIndex = Math.floor(Math.random() * pool.length);
      const chosenNumber = pool.splice(randomIndex, 1)[0];
      
      // 自動依照最大位數補零（如最大值為 100，抽中 7 則顯示 "007"）
      const targetStr = chosenNumber.toString().padStart(maxDigits, '0');
      const digitBoxes = digitsContainer.querySelectorAll('.digit-box');

      // 重置所有格子樣式並開始滾動
      intervals = [];
      digitBoxes.forEach((box, i) => {
        box.className = 'digit-box rolling';
        
        // 快速輪播 0-9
        const interval = setInterval(() => {
          box.textContent = Math.floor(Math.random() * 10);
        }, 60);
        intervals.push(interval);
      });

      // 依序由高位數（從左到右）陸續停下開出
      const baseDelay = 1200;  // 最高位數最少旋轉時間
      const stepDelay = 800;   // 每個下一位數停下的間隔

      for (let i = 0; i < maxDigits; i++) {
        setTimeout(() => {
          clearInterval(intervals[i]);
          digitBoxes[i].textContent = targetStr[i];
          digitBoxes[i].className = 'digit-box settled';

          // 若為最後一位數，代表抽獎結束
          if (i === maxDigits - 1) {
            isDrawing = false;
            btnStart.disabled = false;
            btnExit.disabled = false;
            
            // 紀錄到開獎歷史
            historyList.unshift(targetStr);
            renderHistory();
            updateRemaining();
          }
        }, baseDelay + (i * stepDelay));
      }
    });

    // 渲染歷史清單
    function renderHistory() {
      historyCount.textContent = `${historyList.length} 個`;
      if (historyList.length === 0) {
        historyListContainer.innerHTML = '<div class="empty-history">尚未抽出任何號碼</div>';
        return;
      }

      historyListContainer.innerHTML = '';
      historyList.forEach((numStr, index) => {
        const badge = document.createElement('span');
        badge.className = `history-badge ${index === 0 ? 'latest' : ''}`;
        badge.textContent = numStr;
        historyListContainer.appendChild(badge);
      });
    }

    // 按下結束鍵，跳出確認視窗
    btnExit.addEventListener('click', () => {
      if (isDrawing) return;

      const confirmExit = confirm('確定要結束本次抽獎活動並返回設定頁面嗎？\n（當前的抽獎進度與開獎清單將會被重置）');
      if (confirmExit) {
        // 重置並返回起始畫面
        intervals.forEach(clearInterval);
        lotteryScreen.classList.remove('active');
        setupScreen.classList.add('active');
      }
    });
  </script>
</body>
</html>
